digraph arche_reasoning_tree {
    // Core research idea (root node)
    research_idea [label="(0,0,0) ARCHE: A benchmark and task for evaluating LLMs' ability to extract and formalize latent reasoning chains using Peirce's three reasoning paradigms"];

    // ========== BRANCH 1: Problem Identification (Abductive) ==========

    // Abductive reasoning: LLMs used in science + poor understanding of reasoning → need for evaluation
    phenomenon1 [label="(1,1,0) Abduction-phenomenon: LLMs are increasingly applied in scientific domains"];
    knowledge1 [label="(2,2,0) Abduction-knowledge: It is poorly understood how well LLMs understand human reasoning"];
    hypothesis1 [label="(0,0,0) There is a need to evaluate LLMs' understanding of reasoning in scientific contexts"];

    phenomenon1 -> hypothesis1 [label="abduction-phenomenon"];
    knowledge1 -> hypothesis1 [label="abduction-knowledge"];

    // Deductive reasoning: Uncertainty about reasoning + scientific workflows → trustworthiness concerns
    rule1 [label="(0,0,0) Deduction-rule: If LLMs' reasoning ability is uncertain, then there are trustworthiness concerns in scientific applications"];
    case1 [label="(3,1,0) Deduction-case: LLMs' ability to follow structured paradigm-based reasoning is uncertain"];
    conclusion1 [label="(3,3,0) This raises concerns about the trustworthiness of LLM-driven scientific workflows"];

    rule1 -> conclusion1 [label="deduction-rule"];
    case1 -> conclusion1 [label="deduction-case"];

    // ========== BRANCH 2: Theoretical Foundation (Deductive) ==========

    // Deductive reasoning: Peirce's taxonomy + need for trustworthy reasoning → paradigm understanding is essential
    rule2 [label="(4,1,0) Deduction-rule: If all valid reasoning follows Peirce's taxonomy (deductive, inductive, abductive), then understanding these paradigms is necessary for valid reasoning"];
    case2 [label="(0,0,0) Deduction-case: LLMs need to perform trustworthy scientific reasoning"];
    conclusion2 [label="(4,2,0) Understanding and applying elementary paradigms of reasoning is essential for LLMs to perform trustworthy scientific reasoning"];

    rule2 -> conclusion2 [label="deduction-rule"];
    case2 -> conclusion2 [label="deduction-case"];

    // ========== BRANCH 3: Human Scientific Reasoning (Inductive) ==========

    // Inductive reasoning: Multiple observations about human scientific reasoning → general pattern
    common1 [label="(0,0,0) Induction-common: Scientific reasoning is a structured, multi-paradigm process"];
    case3 [label="(5,1,0) Induction-case: Human scientists employ mixed inferential strategies"];
    case4 [label="(6,2,0) Induction-case: Scientific discoveries are chains of reasoning steps that traverse multiple paradigms"];

    common1 -> scientific_reasoning_nature [label="induction-common"];
    case3 -> scientific_reasoning_nature [label="induction-case"];

    case5 [label="(7,1,0) Induction-case: Scientific discovery involves latent reasoning chains"];
    case4 -> latent_chains [label="induction-case"];
    case5 -> latent_chains [label="induction-case"];
    common2 [label="(7,3,0) Induction-common: Latent reasoning chains connect existing knowledge to new insights"];
    common2 -> latent_chains [label="induction-common"];

    scientific_reasoning_nature [label="(0,0,0) Human scientific reasoning involves structured multi-paradigm inference processes"];
    latent_chains [label="(0,0,0) Scientific discovery depends on latent, implicit reasoning chains"];

    // ========== BRANCH 4: Gap in Existing Benchmarks (Inductive) ==========

    // Inductive reasoning: Multiple failures in existing benchmarks → general inadequacy
    common3 [label="(0,0,0) Induction-common: Existing benchmarks inadequately evaluate paradigm-based reasoning"];
    case6 [label="(8,1,0) Induction-case: Existing benchmarks fail to evaluate whether LLMs can recognize the three reasoning paradigms"];
    case7 [label="(8,2,0) Induction-case: Existing benchmarks fail to evaluate whether LLMs can incorporate paradigms into coherent reasoning chains"];
    case8 [label="(8,3,0) Induction-case: Existing benchmarks fail to evaluate whether LLMs can ground each step in verifiable textual evidence"];

    common3 -> benchmark_gap [label="induction-common"];
    case6 -> benchmark_gap [label="induction-case"];

    case7 -> benchmark_gap2 [label="induction-case"];
    common3 -> benchmark_gap2 [label="induction-common"];

    benchmark_gap [label="(0,0,0) Existing benchmarks do not evaluate paradigm recognition and coherent reasoning chain construction"];
    benchmark_gap2 [label="(0,0,0) There is a critical gap in evaluating LLMs' paradigm-based reasoning abilities"];

    // ========== BRANCH 5: ARCHE Task Design (Deductive) ==========

    // Deductive reasoning: Gap in benchmarks + need for evaluation → propose ARCHE
    rule3 [label="(0,0,0) Deduction-rule: If existing benchmarks fail to evaluate paradigm-based reasoning, then a new benchmark is needed"];
    case9 [label="(0,0,0) Deduction-case: Benchmark_gap2 conclusion"];
    conclusion3 [label="(9,1,0) We propose ARCHE (Latent Reasoning Chain Extraction)"];

    rule3 -> conclusion3 [label="deduction-rule"];
    benchmark_gap2 -> conclusion3 [label="deduction-case"];

    // ARCHE method specification (Inductive)
    common4 [label="(9,2,0) Induction-common: ARCHE is designed to recognize underlying reasoning behind scientific claims"];
    case10 [label="(10,1,0) Induction-case: ARCHE leverages an LLM to extract fine-grained reasoning steps"];
    case11 [label="(10,2,0) Induction-case: ARCHE classifies each step as deductive, inductive, or abductive reasoning"];

    common4 -> arche_method [label="induction-common"];
    case10 -> arche_method [label="induction-case"];

    case12 [label="(11,1,0) Induction-case: Reasoning steps are assembled into a Reasoning Logic Tree"];
    case11 -> arche_structure [label="induction-case"];
    case12 -> arche_structure [label="induction-case"];
    common5 [label="(11,3,0) Induction-common: Labeled edges link premise nodes to conclusion nodes"];
    common5 -> arche_structure [label="induction-common"];

    arche_method [label="(0,0,0) ARCHE extracts and classifies fine-grained reasoning steps from scientific papers"];
    arche_structure [label="(0,0,0) ARCHE uses RLT structure to represent reasoning chains with typed edges"];

    // ========== BRANCH 6: ARCHE Bench Implementation (Deductive) ==========

    // Deductive: Need for grounded evaluation + real data → ARCHE Bench
    rule4 [label="(0,0,0) Deduction-rule: If reasoning steps need to be grounded in real tasks, then real scientific papers are required"];
    case13 [label="(8,3,0) Deduction-case: Reasoning steps must be grounded in verifiable textual evidence"];
    conclusion4 [label="(13,1,0) We introduce ARCHE Bench benchmark"];

    rule4 -> conclusion4 [label="deduction-rule"];
    case13 -> conclusion4 [label="deduction-case"];

    // ARCHE Bench composition (facts leading to conclusion)
    bench_fact1 [label="(13,2,0) ARCHE Bench is derived from 70 peer-reviewed Nature Communication articles"];
    bench_fact2 [label="(14,1,0) Each paper includes its introduction"];
    bench_fact3 [label="(14,2,0) Each paper includes relevant background viewpoints"];

    bench_fact1 -> arche_bench_design [label="deduction-case"];
    rule5 [label="(0,0,0) Deduction-rule: If a benchmark includes peer-reviewed papers with introductions and background viewpoints, then it provides grounded evaluation data"];
    rule5 -> arche_bench_design [label="deduction-rule"];

    arche_bench_design [label="(0,0,0) ARCHE Bench provides grounded, real-world data for evaluating reasoning extraction"];

    // ========== BRANCH 7: Evaluation Metrics (Inductive) ==========

    // Inductive: Two metrics with complementary purposes → comprehensive evaluation
    common6 [label="(15,1,0) Induction-common: We propose two complementary metrics for RLT evaluation"];
    case14 [label="(15,2,0) Induction-case: EC measures proportion of key scientific entities in predicted RLT"];
    case15 [label="(15,4,0) Induction-case: REA assesses accuracy of individual inference steps"];

    common6 -> metrics_design [label="induction-common"];
    case14 -> metrics_design [label="induction-case"];

    case16 [label="(16,1,0) Induction-case: EC ensures no critical pieces are omitted"];
    case17 [label="(16,2,0) Induction-case: REA evaluates logical validity at the step level"];
    case15 -> metrics_coverage [label="induction-case"];
    case16 -> metrics_coverage [label="induction-case"];
    common7 [label="(0,0,0) Induction-common: Together, EC and REA capture both completeness and correctness"];
    common7 -> metrics_coverage [label="induction-common"];

    metrics_design [label="(0,0,0) ARCHE uses complementary metrics (EC and REA) for comprehensive evaluation"];
    metrics_coverage [label="(0,0,0) The metrics ensure both content coverage and logical validity are assessed"];

    // ========== BRANCH 8: Empirical Findings (Inductive + Abductive) ==========

    // Inductive: Evaluation results → general conclusion about LLM limitations
    common8 [label="(0,0,0) Induction-common: LLMs show fundamental limitations in paradigm-based reasoning"];
    case18 [label="(17,2,0) Induction-case: Even best models struggle to exceed 50% accuracy"];
    case19 [label="(18,1,0) Induction-case: We observe a trade-off between EC and REA"];

    common8 -> empirical_findings [label="induction-common"];
    case18 -> empirical_findings [label="induction-case"];

    case19 -> tradeoff_finding [label="induction-case"];
    common9 [label="(18,2,0) Induction-common: Models achieving higher EC often sacrifice REA"];
    common9 -> tradeoff_finding [label="induction-common"];

    empirical_findings [label="(17,3,0) LLMs have limited ability to recognize and formalize latent reasoning chains via standard paradigms"];
    tradeoff_finding [label="(0,0,0) There is a fundamental trade-off between coverage and logical validity in current LLMs"];

    // ========== FINAL CONVERGENCE TO RESEARCH IDEA ==========

    // Multiple lines of reasoning converge to the final research proposal

    // Abductive: Need + gap → propose solution
    hypothesis1 -> research_idea [label="abduction-phenomenon"];
    conclusion1 -> research_idea [label="abduction-phenomenon"];
    benchmark_gap2 -> research_idea [label="abduction-phenomenon"];

    conclusion2 -> research_idea [label="abduction-knowledge"];
    latent_chains -> research_idea [label="abduction-knowledge"];

    // Deductive: Method specification
    arche_method -> research_idea [label="deduction-case"];
    arche_structure -> research_idea [label="deduction-case"];
    rule6 [label="(0,0,0) Deduction-rule: If we extract and classify reasoning steps into RLT structure from real papers using complementary metrics, then we have a complete evaluation framework"];
    rule6 -> research_idea [label="deduction-rule"];

    arche_bench_design -> research_idea [label="deduction-case"];
    metrics_coverage -> research_idea [label="deduction-case"];

    // Inductive: Empirical validation
    empirical_findings -> research_idea [label="induction-case"];
    tradeoff_finding -> research_idea [label="induction-case"];
    common10 [label="(0,0,0) Induction-common: ARCHE successfully reveals fundamental gaps in LLM reasoning capabilities"];
    common10 -> research_idea [label="induction-common"];
}
