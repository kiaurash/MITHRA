digraph arche_reasoning_tree {
    // ========== ROOT NODE ==========
    research_idea [label="(0,0,0) ARCHE: A benchmark and task for evaluating LLMs' ability to extract and formalize latent reasoning chains using Peirce's three reasoning paradigms"];

    // ========== BRANCH 1: Problem Identification ==========

    // Abductive reasoning: LLMs used in science + poor understanding → need for evaluation
    phenomenon1 [label="(1,1,0) LLMs are increasingly applied in scientific domains"];
    knowledge1 [label="(2,2,0) It is poorly understood how well LLMs understand human reasoning"];
    hypothesis1 [label="(0,0,0) There is a need to evaluate LLMs' understanding of reasoning in scientific contexts"];

    phenomenon1 -> hypothesis1 [label="abduction-phenomenon"];
    knowledge1 -> hypothesis1 [label="abduction-knowledge"];

    // Deductive reasoning: Uncertain reasoning ability → trustworthiness concerns
    rule1 [label="(0,0,0) If LLMs' reasoning ability is uncertain, then there are trustworthiness concerns in scientific applications"];
    case1 [label="(3,1,0) LLMs' ability to follow structured paradigm-based reasoning is uncertain"];
    conclusion1 [label="(3,3,0) This raises concerns about the trustworthiness of LLM-driven scientific workflows"];

    rule1 -> conclusion1 [label="deduction-rule"];
    case1 -> conclusion1 [label="deduction-case"];

    // ========== BRANCH 2: Theoretical Foundation ==========

    // Deductive: Peirce's taxonomy + need for trustworthy reasoning → paradigm understanding essential
    rule2 [label="(4,1,0) If all valid reasoning follows Peirce's taxonomy (deductive, inductive, abductive), then understanding these paradigms is necessary for valid reasoning"];
    case2 [label="(0,0,0) LLMs need to perform trustworthy scientific reasoning"];
    conclusion2 [label="(4,2,0) Understanding and applying elementary paradigms of reasoning is essential for LLMs to perform trustworthy scientific reasoning"];

    rule2 -> conclusion2 [label="deduction-rule"];
    case2 -> conclusion2 [label="deduction-case"];

    // ========== BRANCH 3: Nature of Scientific Reasoning ==========

    // Inductive: Observations about human reasoning → general pattern
    common1 [label="(0,0,0) Human scientific reasoning involves structured multi-paradigm inference processes"];
    case3 [label="(5,1,0) Human scientists employ mixed inferential strategies"];
    case4 [label="(6,2,0) Scientific discoveries are chains of reasoning steps that traverse multiple paradigms"];

    common1 -> scientific_reasoning_nature [label="induction-common"];
    case3 -> scientific_reasoning_nature [label="induction-case"];

    scientific_reasoning_nature [label="(0,0,0) Scientific discovery requires multi-paradigm reasoning chains"];

    // Inductive: Latent reasoning observations
    common2 [label="(7,3,0) Latent reasoning chains connect existing knowledge to new insights"];
    case5 [label="(7,1,0) Scientific discovery involves latent reasoning chains"];
    case6 [label="(7,2,0) Latent reasoning chains are composed of implicit, unspoken steps"];

    common2 -> latent_chains [label="induction-common"];
    case5 -> latent_chains [label="induction-case"];

    latent_chains [label="(0,0,0) Scientific discovery depends on implicit, latent reasoning chains that connect knowledge to insights"];

    // ========== BRANCH 4: Gap in Existing Benchmarks ==========

    // Inductive: Multiple benchmark failures → general inadequacy
    common3 [label="(0,0,0) Existing benchmarks inadequately evaluate paradigm-based reasoning"];
    case7 [label="(8,1,0) Existing benchmarks fail to evaluate whether LLMs can recognize the three reasoning paradigms"];
    case8 [label="(8,2,0) Existing benchmarks fail to evaluate whether LLMs can incorporate paradigms into coherent reasoning chains"];
    case9 [label="(8,3,0) Existing benchmarks fail to evaluate whether LLMs can ground each step in verifiable textual evidence"];

    common3 -> benchmark_gap [label="induction-common"];
    case7 -> benchmark_gap [label="induction-case"];

    benchmark_gap [label="(0,0,0) Existing benchmarks do not evaluate paradigm recognition and reasoning chain construction"];

    // ========== BRANCH 5: Proposed Solution - ARCHE Task ==========

    // Deductive: Gap + need → propose ARCHE
    rule3 [label="(0,0,0) If existing benchmarks fail to evaluate paradigm-based reasoning, then a new benchmark is needed"];
    case10 [label="(0,0,0) Existing benchmarks fail to evaluate paradigm-based reasoning (from benchmark_gap)"];

    benchmark_gap -> case10 [label="deduction-case"];

    rule3 -> arche_proposal [label="deduction-rule"];
    case10 -> arche_proposal [label="deduction-case"];

    arche_proposal [label="(9,1,0) We propose ARCHE (Latent Reasoning Chain Extraction)"];

    // ARCHE method specification (Inductive)
    common4 [label="(9,2,0) ARCHE is designed to recognize underlying reasoning behind scientific claims"];
    case11 [label="(10,1,0) ARCHE leverages an LLM to extract fine-grained reasoning steps"];
    case12 [label="(10,2,0) ARCHE classifies each step as deductive, inductive, or abductive reasoning"];

    common4 -> arche_method [label="induction-common"];
    case11 -> arche_method [label="induction-case"];

    arche_method [label="(0,0,0) ARCHE extracts and classifies fine-grained reasoning steps from scientific papers"];

    // RLT structure (Inductive)
    common5 [label="(11,3,0) Labeled edges link premise nodes to conclusion nodes"];
    case13 [label="(11,1,0) Reasoning steps are assembled into a Reasoning Logic Tree"];
    case14 [label="(11,2,0) In RLT, nodes correspond to individual premise or conclusion sentences"];

    common5 -> rlt_structure [label="induction-common"];
    case13 -> rlt_structure [label="induction-case"];

    rlt_structure [label="(0,0,0) ARCHE uses RLT structure to represent reasoning chains with typed edges"];

    // ARCHE capabilities (Deductive)
    rule4 [label="(0,0,0) If a method recognizes paradigms and assembles them into structured representations, then it delivers faithful representations of complex arguments"];
    case15 [label="(12,1,0) ARCHE recognizes distinct reasoning paradigms"];
    case16 [label="(12,2,0) ARCHE assembles paradigms into an RLT"];

    rule4 -> arche_capability [label="deduction-rule"];
    case15 -> arche_capability [label="deduction-case"];

    arche_capability [label="(12,3,0) ARCHE delivers a faithful, structured representation of complex scientific arguments"];

    // ========== BRANCH 6: ARCHE Bench Implementation ==========

    // Deductive: Need for grounding + real data → ARCHE Bench
    rule5 [label="(0,0,0) If reasoning steps need to be grounded in real tasks, then real scientific papers are required"];
    case17 [label="(8,3,0) Reasoning steps must be grounded in verifiable textual evidence"];

    rule5 -> bench_proposal [label="deduction-rule"];
    case17 -> bench_proposal [label="deduction-case"];

    bench_proposal [label="(13,1,0) We introduce ARCHE Bench benchmark"];

    // Bench composition (Deductive)
    rule6 [label="(0,0,0) If a benchmark includes peer-reviewed papers with introductions and background viewpoints, then it provides grounded evaluation data"];
    case18 [label="(13,2,0) ARCHE Bench is derived from 70 peer-reviewed Nature Communication articles"];

    rule6 -> bench_design [label="deduction-rule"];
    case18 -> bench_design [label="deduction-case"];

    bench_design [label="(0,0,0) ARCHE Bench provides grounded, real-world data for evaluating reasoning extraction"];

    // ========== BRANCH 7: Evaluation Metrics ==========

    // Inductive: Two complementary metrics → comprehensive evaluation
    common6 [label="(15,1,0) We propose two complementary metrics for RLT evaluation"];
    case19 [label="(15,2,0) EC measures proportion of key scientific entities in predicted RLT"];
    case20 [label="(15,4,0) REA assesses accuracy of individual inference steps"];

    common6 -> metrics_base [label="induction-common"];
    case19 -> metrics_base [label="induction-case"];

    metrics_base [label="(0,0,0) ARCHE uses two metrics: EC for coverage and REA for accuracy"];

    // Metrics purpose (Inductive)
    common7 [label="(0,0,0) Together, EC and REA capture both completeness and correctness"];
    case21 [label="(16,1,0) EC ensures no critical pieces are omitted"];
    case22 [label="(16,2,0) REA evaluates logical validity at the step level"];

    common7 -> metrics_purpose [label="induction-common"];
    case21 -> metrics_purpose [label="induction-case"];

    metrics_purpose [label="(0,0,0) The metrics ensure both content coverage and logical validity are assessed"];

    // ========== BRANCH 8: Empirical Findings ==========

    // Inductive: Evaluation results → LLM limitations
    common8 [label="(0,0,0) LLMs show fundamental limitations in paradigm-based reasoning"];
    case23 [label="(17,2,0) Even best models struggle to exceed 50% accuracy"];

    common8 -> empirical_findings [label="induction-common"];
    case23 -> empirical_findings [label="induction-case"];

    empirical_findings [label="(17,3,0) LLMs have limited ability to recognize and formalize latent reasoning chains via standard paradigms"];

    // Trade-off finding (Inductive)
    common9 [label="(18,2,0) Models achieving higher EC often sacrifice REA"];
    case24 [label="(18,1,0) We observe a trade-off between EC and REA"];

    common9 -> tradeoff_finding [label="induction-common"];
    case24 -> tradeoff_finding [label="induction-case"];

    tradeoff_finding [label="(0,0,0) There is a fundamental trade-off between coverage and logical validity in current LLMs"];

    // ========== CONVERGENCE TO RESEARCH IDEA ==========

    // Synthesize problem identification
    rule7 [label="(0,0,0) If there is a need to evaluate reasoning and existing benchmarks are inadequate, then new evaluation methods are necessary"];
    hypothesis1 -> problem_synthesis [label="deduction-case"];
    benchmark_gap -> problem_synthesis [label="deduction-case"];
    rule7 -> problem_synthesis [label="deduction-rule"];

    problem_synthesis [label="(0,0,0) A new evaluation approach is needed for LLM reasoning in scientific contexts"];

    // Synthesize ARCHE solution
    rule8 [label="(0,0,0) If we have a task (ARCHE), a benchmark (ARCHE Bench), and evaluation metrics (EC, REA), then we have a complete evaluation framework"];
    arche_capability -> solution_synthesis [label="deduction-case"];
    bench_design -> solution_synthesis [label="deduction-case"];
    metrics_purpose -> solution_synthesis [label="deduction-case"];
    rule8 -> solution_synthesis [label="deduction-rule"];

    solution_synthesis [label="(0,0,0) ARCHE provides a complete framework: task + benchmark + metrics"];

    // Synthesize validation
    rule9 [label="(0,0,0) If empirical findings reveal fundamental limitations and trade-offs, then the evaluation framework successfully identifies gaps"];
    empirical_findings -> validation_synthesis [label="deduction-case"];
    tradeoff_finding -> validation_synthesis [label="deduction-case"];
    rule9 -> validation_synthesis [label="deduction-rule"];

    validation_synthesis [label="(0,0,0) ARCHE successfully reveals fundamental gaps in LLM reasoning capabilities"];

    // Final synthesis to research idea (Deductive)
    rule10 [label="(0,0,0) If we identify a need, propose a solution framework, and validate it empirically, then we have established a novel benchmark"];
    problem_synthesis -> research_idea [label="deduction-case"];
    solution_synthesis -> research_idea [label="deduction-case"];
    validation_synthesis -> research_idea [label="deduction-case"];
    rule10 -> research_idea [label="deduction-rule"];
}
