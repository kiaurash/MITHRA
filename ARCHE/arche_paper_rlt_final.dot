digraph arche_reasoning_tree {
    // ROOT NODE
    research_idea [label="(0,0,0) ARCHE: A benchmark and task for evaluating LLMs' ability to extract and formalize latent reasoning chains using Peirce's three reasoning paradigms"];

    // ===== PROBLEM IDENTIFICATION =====

    // Abduction: LLM usage + poor understanding → need
    phenom1 [label="(1,1,0) LLMs are increasingly applied in scientific domains"];
    knowl1 [label="(2,2,0) It is poorly understood how well LLMs understand human reasoning"];
    hyp1 [label="(0,0,0) There is a need to evaluate LLMs' understanding of reasoning"];

    phenom1 -> hyp1 [label="abduction-phenomenon"];
    knowl1 -> hyp1 [label="abduction-knowledge"];

    // Deduction: Uncertainty → trustworthiness concerns
    rule1 [label="(0,0,0) If reasoning ability is uncertain, then trustworthiness concerns arise"];
    case1 [label="(3,1,0) LLMs' ability to follow structured paradigm-based reasoning is uncertain"];
    concl1 [label="(3,3,0) This raises concerns about trustworthiness of LLM-driven scientific workflows"];

    rule1 -> concl1 [label="deduction-rule"];
    case1 -> concl1 [label="deduction-case"];

    // ===== THEORETICAL FOUNDATION =====

    // Deduction: Peirce's taxonomy → paradigm understanding essential
    rule2 [label="(4,1,0) If all valid reasoning follows Peirce's taxonomy, then understanding these paradigms is necessary"];
    case2 [label="(0,0,0) LLMs need to perform trustworthy scientific reasoning"];
    concl2 [label="(4,2,0) Understanding paradigms of reasoning is essential for LLMs"];

    rule2 -> concl2 [label="deduction-rule"];
    case2 -> concl2 [label="deduction-case"];

    // ===== BENCHMARK GAP =====

    // Induction: Multiple benchmark failures → general inadequacy
    common1 [label="(0,0,0) Existing benchmarks inadequately evaluate paradigm-based reasoning"];
    case3 [label="(8,1,0) Existing benchmarks fail to evaluate paradigm recognition"];
    case4 [label="(8,2,0) Existing benchmarks fail to evaluate reasoning chain construction"];

    common1 -> gap1 [label="induction-common"];
    case3 -> gap1 [label="induction-case"];

    gap1 [label="(0,0,0) Existing benchmarks do not evaluate paradigm-based reasoning"];

    // ===== ARCHE TASK PROPOSAL =====

    // Deduction: Gap → need new benchmark
    rule3 [label="(0,0,0) If existing benchmarks fail, then a new benchmark is needed"];

    gap1 -> prop1 [label="deduction-case"];
    rule3 -> prop1 [label="deduction-rule"];

    prop1 [label="(9,1,0) We propose ARCHE"];

    // Induction: ARCHE method features → capability
    common2 [label="(9,2,0) ARCHE recognizes underlying reasoning"];
    case5 [label="(10,1,0) ARCHE extracts fine-grained reasoning steps"];
    case6 [label="(10,2,0) ARCHE classifies steps as deductive, inductive, or abductive"];

    common2 -> method1 [label="induction-common"];
    case5 -> method1 [label="induction-case"];

    method1 [label="(0,0,0) ARCHE extracts and classifies reasoning steps"];

    // Induction: RLT features → structured representation
    common3 [label="(11,3,0) Labeled edges link premise nodes to conclusions"];
    case7 [label="(11,1,0) Steps are assembled into Reasoning Logic Tree"];
    case8 [label="(11,2,0) Nodes correspond to premise or conclusion sentences"];

    common3 -> struct1 [label="induction-common"];
    case7 -> struct1 [label="induction-case"];

    struct1 [label="(0,0,0) ARCHE uses RLT structure with typed edges"];

    // Deduction: Method + structure → faithful representation
    rule4 [label="(0,0,0) If method recognizes paradigms and uses structured representation, then it delivers faithful representations"];
    method1 -> cap1 [label="deduction-case"];
    struct1 -> cap1 [label="deduction-case"];
    rule4 -> cap1 [label="deduction-rule"];

    cap1 [label="(12,3,0) ARCHE delivers faithful, structured representation of scientific arguments"];

    // ===== ARCHE BENCH =====

    // Deduction: Need grounding → use real papers
    rule5 [label="(0,0,0) If reasoning needs grounding, then real papers are required"];
    case9 [label="(8,3,0) Steps must be grounded in verifiable textual evidence"];

    rule5 -> bench1 [label="deduction-rule"];
    case9 -> bench1 [label="deduction-case"];

    bench1 [label="(13,1,0) We introduce ARCHE Bench"];

    // Deduction: Papers + viewpoints → grounded data
    rule6 [label="(0,0,0) If benchmark includes peer-reviewed papers with viewpoints, then it provides grounded data"];
    case10 [label="(13,2,0) ARCHE Bench uses 70 Nature Communications articles"];

    rule6 -> data1 [label="deduction-rule"];
    case10 -> data1 [label="deduction-case"];

    data1 [label="(0,0,0) ARCHE Bench provides grounded evaluation data"];

    // ===== METRICS =====

    // Induction: Two metrics → comprehensive evaluation
    common4 [label="(15,1,0) Two complementary metrics evaluate RLT"];
    case11 [label="(15,2,0) EC measures entity coverage"];
    case12 [label="(15,4,0) REA assesses inference accuracy"];

    common4 -> metr1 [label="induction-common"];
    case11 -> metr1 [label="induction-case"];

    metr1 [label="(0,0,0) EC and REA provide comprehensive evaluation"];

    // Induction: Metric purposes → dual assessment
    common5 [label="(0,0,0) EC and REA capture completeness and correctness"];
    case13 [label="(16,1,0) EC ensures no critical pieces omitted"];
    case14 [label="(16,2,0) REA evaluates logical validity"];

    common5 -> metr2 [label="induction-common"];
    case13 -> metr2 [label="induction-case"];

    metr2 [label="(0,0,0) Metrics assess both coverage and validity"];

    // ===== EMPIRICAL FINDINGS =====

    // Induction: Results → LLM limitations
    common6 [label="(0,0,0) LLMs show fundamental reasoning limitations"];
    case15 [label="(17,2,0) Best models struggle to exceed 50% accuracy"];

    common6 -> find1 [label="induction-common"];
    case15 -> find1 [label="induction-case"];

    find1 [label="(17,3,0) LLMs have limited ability to formalize reasoning chains"];

    // Induction: Trade-off observation
    common7 [label="(18,2,0) Higher EC often sacrifices REA"];
    case16 [label="(18,1,0) We observe EC-REA trade-off"];

    common7 -> find2 [label="induction-common"];
    case16 -> find2 [label="induction-case"];

    find2 [label="(0,0,0) Fundamental trade-off exists between coverage and validity"];

    // ===== SYNTHESIS LAYERS =====

    // Synthesize problem (Abduction)
    phenom2 [label="(0,0,0) Phenomenon: Need evaluation + benchmarks inadequate"];
    knowl2 [label="(0,0,0) Knowledge: Paradigm understanding is essential"];

    hyp1 -> phenom2 [label="abduction-phenomenon"];
    gap1 -> phenom2 [label="abduction-phenomenon"];
    concl2 -> knowl2 [label="abduction-knowledge"];

    phenom2 -> prob_synth [label="abduction-phenomenon"];
    knowl2 -> prob_synth [label="abduction-knowledge"];

    prob_synth [label="(0,0,0) New paradigm-based evaluation approach is needed"];

    // Synthesize solution (Deduction)
    rule7 [label="(0,0,0) If we have task + benchmark + metrics, then we have complete framework"];
    cap1 -> sol_synth [label="deduction-case"];
    data1 -> sol_synth [label="deduction-case"];
    metr2 -> sol_synth [label="deduction-case"];
    rule7 -> sol_synth [label="deduction-rule"];

    sol_synth [label="(0,0,0) ARCHE provides complete evaluation framework"];

    // Synthesize validation (Induction)
    common8 [label="(0,0,0) Empirical results validate framework's effectiveness"];
    find1 -> val_synth [label="induction-case"];
    find2 -> val_synth [label="induction-case"];
    common8 -> val_synth [label="induction-common"];

    val_synth [label="(0,0,0) ARCHE successfully reveals LLM reasoning gaps"];

    // ===== FINAL CONVERGENCE (Deduction) =====

    rule8 [label="(0,0,0) If we identify need, propose solution, and validate empirically, then we establish novel benchmark"];
    prob_synth -> research_idea [label="deduction-case"];
    sol_synth -> research_idea [label="deduction-case"];
    val_synth -> research_idea [label="deduction-case"];
    rule8 -> research_idea [label="deduction-rule"];
}
